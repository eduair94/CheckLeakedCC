{
  "name": "checkleakedcc",
  "version": "2.0.0",
  "description": "Official Node.js / TypeScript SDK for checkleaked.cc — data-breach search (Dehashed, Snusbase/experimental), hash cracking, GHunt, breach monitoring/tracking, and the full LeakRadar integration (email/domain/advanced/raw search, unlocked archive, notifications, dark web).",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "alt_test": "node test/index.js",
    "test": "jest --config jestconfig.json",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "lint": "eslint src",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
    "preversion": "npm run typecheck && npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduAir94/CheckLeakedCC.git"
  },
  "keywords": [
    "checkleaked",
    "leakcheck",
    "leakradar",
    "dehashed",
    "snusbase",
    "data-breach",
    "breach",
    "osint",
    "hash",
    "hibp",
    "dark-web",
    "credential",
    "leak",
    "monitoring"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EduAir94/CheckLeakedCC/issues"
  },
  "homepage": "https://github.com/EduAir94/CheckLeakedCC#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.4",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "files": [
    "dist"
  ]
}
